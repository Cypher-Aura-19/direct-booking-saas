# Required for the app to reach Supabase. For local dev, run `npx supabase status`
# and copy API_URL / ANON_KEY into a real .env.local (gitignored, not this file).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: only needed if request-header-based origin detection (see
# web/app/signup/actions.ts, web/app/forgot-password/actions.ts) isn't
# reliable in your deployment environment.
NEXT_PUBLIC_SITE_URL=
